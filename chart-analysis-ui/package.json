{
  "name": "chart-analysis-ui",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://127.0.0.1:3001",
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "duckdb": "^1.4.4",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scripts": "5.0.1",
    "recharts": "^3.9.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently -k -n api,ui -c blue,green \"npm run api\" \"npm run start:ui\"",
    "start:ui": "react-scripts start",
    "api": "node server/index.js",
    "build": "DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "serve": "SERVE_STATIC=1 API_PORT=3002 node server/index.js",
    "fixture": "node server/create-fixture.js",
    "test": "npm run test:api",
    "test:api": "node --test server/db.test.js"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
